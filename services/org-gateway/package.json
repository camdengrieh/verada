{
  "name": "@varada/org-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "arkiv": "tsx scripts/arkiv-mirror.ts",
    "op-mint": "tsx scripts/op-mint.ts",
    "build:lambda": "rm -rf dist-lambda && tsc src/lambda.ts src/l2proxy.ts --outDir dist-lambda --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck --types node && echo '{\"type\":\"module\"}' > dist-lambda/package.json"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@hono/node-server": "^1.19.5",
    "@varada/cause-catalog": "workspace:*",
    "hono": "^4.13.16",
    "tsx": "^4.23.15",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
