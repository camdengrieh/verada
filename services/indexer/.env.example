# Ethereum mainnet (chain id 1) JSON-RPC endpoint
PONDER_RPC_URL_1=
# Deployed contract addresses
FACTORY_ADDRESS=
FEE_VAULT_ADDRESS=
FEE_CONSOLIDATOR_ADDRESS=
QUOTE_REGISTRY_ADDRESS=
CAUSE_REGISTRY_ADDRESS=
EPOCH_GOVERNOR_ADDRESS=
DONATION_DISTRIBUTOR_ADDRESS=
TOKEN_REGISTRY_ADDRESS=
CAUSE_CATALOG_ADDRESS=
CURATOR_REGISTRY_ADDRESS=
# Published cause catalogue served by /api/catalog: a directory, or an http(s) base URL of the
# Swarm collection (e.g. https://<gateway>/bzz/<swarmRef>). Optional; the routes answer 503 without it.
CATALOG_SOURCE=
VOTING_SCHEME_ADDRESS=
TAKEOVER_GOVERNOR_ADDRESS=
# Block at which the contracts were deployed (must be > 0)
START_BLOCK=
# Postgres connection string; omit for embedded PGlite in local dev
DATABASE_URL=
# Database schema (required by `ponder start`; use a distinct value per deployment)
DATABASE_SCHEMA=verada
PORT=42069

# --- Browser-facing HTTP API (all optional) ---
# Comma-separated allowed origins and wildcard-suffix patterns, e.g.
#   https://varada.eth.limo,*.eth.limo,*.bzz.link
# Empty allows GET from any origin (the API is read-only and uses no credentials).
CORS_ALLOWED_ORIGINS=
# Per-IP token bucket: sustained requests per second and burst size
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=60
# Trusted reverse-proxy hops when reading X-Forwarded-For (1 behind the ALB, 0 to ignore the header)
TRUST_PROXY_HOPS=1
# Longest accepted request URL
MAX_URL_LENGTH=2048
# Endaoment search proxy (defaults to the production API); key is optional and never returned
ENDAOMENT_API_URL=
ENDAOMENT_API_KEY=
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_CACHE_MAX_ENTRIES=500
# Server-Sent Events stream: connection cap, DB poll interval, heartbeat, max connection age
SSE_MAX_CLIENTS=500
SSE_POLL_MS=2000
SSE_HEARTBEAT_MS=15000
SSE_MAX_AGE_MS=300000
