  "dependencies": {
    "@1claw/sdk": "0.63.3",
    "@anthropic-ai/sdk": "1.6.0",
    "@hono/node-server": "^1.19.5",
    "hono": "^4.13.16",
    "tsx": "^4.23.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
