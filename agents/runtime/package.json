{
  "name": "varada-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Varada curator agents on a 1Claw runtime: a daily scheduler that runs the due cause-pair agents with Claude Code, and a public chat API for every cause.",
  "scripts": {
