# Build-time defaults. Everything here is public and is overridable at runtime
# by editing config.json in the published bundle. No secrets.
NEXT_PUBLIC_CHAIN_ID=1
# Comma-separated indexer base URLs, tried in order (failover).
NEXT_PUBLIC_INDEXER_URLS=http://localhost:42069
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_FACTORY_DEPLOY_BLOCK=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_GOVERNOR_ADDRESS=
# Private RPC (anon-rpc). All chain reads go through this anonymizing network so the
# RPC provider never sees the user's IP. One of: nym (default), tor-js, passthrough (testing only).
NEXT_PUBLIC_ANON_RPC_NETWORK=nym
# Comma-separated RPCs reached THROUGH the anon network, in failover order. Empty: NEXT_PUBLIC_RPC_URL
# (if set) followed by public RPCs known to accept mixnet exits. Overridable in config.json under
# "privateRpc": { "network", "rpcUrls", "specifier", "workerConfig", "bootstrapRpcUrl" }.
NEXT_PUBLIC_PRIVATE_RPC_URLS=
# Profiles, uploads and voting (all public values; overridable in config.json under the same
# camelCase key, e.g. "publisherUrl", "swarmGatewayUrl", "ensParentName").
# Publisher service (logo and metadata uploads to Swarm). Uploads never carry a wallet address.
NEXT_PUBLIC_PUBLISHER_URL=http://localhost:42070
# Public Swarm read gateway; logos load from <base>/bzz/<reference>/.
NEXT_PUBLIC_SWARM_GATEWAY_URL=
# Stock logo pack ("assetPacks": { "stocks" } in config.json): the Swarm reference printed by
# `verada-publish upload-pack --dir apps/web/packs/stocks --execute`. Empty: lettered fallbacks.
NEXT_PUBLIC_STOCK_LOGOS_REF=
# Parent ENS name; every token is <label>.<parent>. Also used to read the label from a gateway hostname.
NEXT_PUBLIC_ENS_PARENT_NAME=varada.eth
NEXT_PUBLIC_PROFILE_REGISTRY_ADDRESS=
NEXT_PUBLIC_VOTING_SCHEME_ADDRESS=
NEXT_PUBLIC_TAKEOVER_GOVERNOR_ADDRESS=
# CuratorRegistry ("curatorRegistryAddress" in config.json). The agent donate form reads each agent's
# vault and active flag from it on chain (through the private RPC) and refuses to send funds when it is
# unset or when the indexer's vault differs from the registry's.
NEXT_PUBLIC_CURATOR_REGISTRY_ADDRESS=
# Optional: replaces the Zama SDK's relayer URL for the chain (e.g. an operator proxy). Empty: SDK default.
NEXT_PUBLIC_ZAMA_RELAYER_URL=
# DEVELOPMENT ONLY, build time only (config.json cannot set it): send plaintext ballots to the mock
# scheme instead of encrypting them. Never set for a published build.
NEXT_PUBLIC_DEV_PLAIN_BALLOTS=
