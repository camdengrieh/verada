pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";

import {CauseRegistry} from "../src/CauseRegistry.sol";
import {EpochGovernor} from "../src/EpochGovernor.sol";
import {ICauseCatalog} from "../src/interfaces/ICauseCatalog.sol";
import {ICuratorRegistry} from "../src/interfaces/ICuratorRegistry.sol";
import {IEpochGovernor} from "../src/interfaces/IEpochGovernor.sol";
import {ITokenProfileRegistry} from "../src/interfaces/ITokenProfileRegistry.sol";
import {IEndaomentOrgFundFactory} from "../src/interfaces/external/IEndaomentOrgFundFactory.sol";
import {CurationsMock} from "./mocks/CurationsMock.sol";
import {MockEndaomentRegistry, MockOrgFactory, MockUSDC} from "./mocks/EndaomentMocks.sol";
import {MockProfileRegistryLite, MockVotingScheme} from "./mocks/GovernanceMocks.sol";
import {CatalogFixture, CatalogTree} from "./utils/CatalogFixture.sol";

/// @notice The SDK's ballot plans (`planBallotOpening` / `planBallot`) match the governor at
///         every ballot size the fixture covers (2, 3, 8, 16, 30, 32): pins past the size, blocked
///         pins, curated quotas down to zero free slots, wrong and out-of-bucket picks, hash draws
///         and the sequential walk. The fixture is generated by `packages/sdk` (`gen:fixture`) and
///         checked there for drift. Each case is replayed on a fresh governor state: the governor
///         must accept exactly the planned draws (it reverts on one too many or too few) and commit
///         to exactly the planned options.
contract BallotSizeFixtureCompatTest is Test {
    string internal json;
    uint256 internal epoch;

    CatalogFixture internal cat;
    CauseRegistry internal registry;
    MockVotingScheme internal scheme;
    MockProfileRegistryLite internal profiles;
    CurationsMock internal curations;
    EpochGovernor internal gov;

    address internal owner = makeAddr("owner");
    address internal factory = makeAddr("factory");
    address internal controller = makeAddr("controller");

    function setUp() public {
        json = vm.readFile("test/fixtures/ballot-sizes.json");
        epoch = vm.parseJsonUint(json, ".epoch");
        vm.warp(1_750_000_123);

        MockUSDC usdc = new MockUSDC();
        MockOrgFactory orgFactory =
            new MockOrgFactory(new MockEndaomentRegistry(address(usdc), makeAddr("treasury")));
        registry = new CauseRegistry(owner, IEndaomentOrgFundFactory(address(orgFactory)));
        scheme = new MockVotingScheme();
        profiles = new MockProfileRegistryLite();
        curations = new CurationsMock();

        cat = new CatalogFixture();
        uint256 n = vm.parseJsonUint(json, ".nEntries");
        for (uint256 i; i < n; ++i) {
            string memory e = string.concat(".entries[", vm.toString(i), "]");
            // forge-lint: disable-next-line(unsafe-typecast)
            uint16 bucket = uint16(vm.parseJsonUint(json, string.concat(e, ".bucket")));
            uint32 index = cat.add(bucket, vm.parseJsonBytes32(json, string.concat(e, ".orgId")));
            assertEq(index, vm.parseJsonUint(json, string.concat(e, ".index")), "entry order");
        }
        cat.publish();

        gov = new EpochGovernor(
            owner,
            registry,
            ICauseCatalog(address(cat.catalog())),
            scheme,
            ITokenProfileRegistry(address(profiles))
        );
        scheme.setGovernor(address(gov), true);
        vm.startPrank(owner);
        gov.setFactory(factory);
        gov.setCuratorRegistry(ICuratorRegistry(address(curations)));
        registry.setMaterializer(address(gov), true);
        vm.stopPrank();
        vm.warp(gov.epochStart(epoch));
    }

    function test_sdkPlansMatchTheGovernorAtEverySize() public {
        uint256 n = vm.parseJsonUint(json, ".nCases");
        assertGe(n, 6);
        uint256 snap = vm.snapshotState();
        for (uint256 i; i < n; ++i) {
            vm.revertToState(snap);
            _replay(string.concat(".cases[", vm.toString(i), "]"));
        }
    }

    function _u(string memory c, string memory key) internal view returns (uint256) {
        return vm.parseJsonUint(json, string.concat(c, key));
    }

    function _at(string memory c, string memory key, uint256 i)
        internal
        pure
        returns (string memory)
    {
        return string.concat(c, key, "[", vm.toString(i), "]");
    }

    function _replay(string memory c) internal {
        string memory name = vm.parseJsonString(json, string.concat(c, ".name"));
        address token = vm.parseJsonAddress(json, string.concat(c, ".token"));
        profiles.register(token, controller);
        // forge-lint: disable-next-line(unsafe-typecast)
        profiles.setFocus(token, uint64(_u(c, ".categoryMask")), uint16(_u(c, ".regionMask")));
        vm.prank(factory);
        gov.registerToken(token);

        // Pins are set at the default size, so a smaller size later drops some of them.
        uint256 nPins = _u(c, ".nPins");
        if (nPins != 0) {
            IEpochGovernor.Pin[] memory pins = new IEpochGovernor.Pin[](nPins);
            for (uint256 j; j < nPins; ++j) {
                pins[j] = cat.pin(vm.parseJsonUint(json, _at(c, ".pins", j)));
            }
            vm.prank(controller);
            gov.setShortlist(token, pins);
        }
        uint256 nBlocked = _u(c, ".nBlocked");
        for (uint256 j; j < nBlocked; ++j) {
            bytes32 org = cat.entryAt(vm.parseJsonUint(json, _at(c, ".blocked", j))).orgId;
            vm.prank(owner);
            registry.blockOrg(org);
        }
        uint256 cap = _u(c, ".cap");
        if (cap != 32) {
            vm.prank(owner);
            // forge-lint: disable-next-line(unsafe-typecast)
            gov.setBallotSizeCap(uint8(cap));
        }
        uint256 choice = _u(c, ".choice");
        if (choice != 0) {
            vm.prank(controller);
            // forge-lint: disable-next-line(unsafe-typecast)
            gov.setBallotSize(token, uint8(choice));
        }
        assertEq(gov.ballotSizeFor(token, epoch), _u(c, ".size"), name);

        // Curator picks behind the mock registry, with roots built here.
        uint256 nCur = _u(c, ".nCurations");
        uint16[] memory curBuckets = new uint16[](nCur);
        bytes32[][] memory curLeaves = new bytes32[][](nCur);
        for (uint256 j; j < nCur; ++j) {
            string memory k = _at(c, ".curations", j);
            // forge-lint: disable-next-line(unsafe-typecast)
            curBuckets[j] = uint16(_u(k, ".bucket"));
            uint256 nPicks = _u(k, ".nPicks");
            curLeaves[j] = new bytes32[](nPicks);
            for (uint256 r; r < nPicks; ++r) {
                // forge-lint: disable-next-line(unsafe-typecast)
                uint32 index = uint32(vm.parseJsonUint(json, _at(k, ".pickIndex", r)));
                bytes32 org = vm.parseJsonBytes32(json, _at(k, ".pickOrg", r));
                // forge-lint: disable-next-line(unsafe-typecast)
                curLeaves[j][r] =
                    keccak256(bytes.concat(keccak256(abi.encode(uint8(r), index, org))));
            }
            curations.set(
                curBuckets[j],
                CatalogTree.root(curLeaves[j]),
                // forge-lint: disable-next-line(unsafe-typecast)
                uint8(nPicks),
                // forge-lint: disable-next-line(unsafe-typecast)
                uint16(_u(k, ".weight")),
                1
            );
        }

        IEpochGovernor.CuratedDraw[] memory curated = _curated(c, curBuckets, curLeaves);
        IEpochGovernor.Draw[] memory draws = _draws(c);

        bytes32 action = keccak256(bytes(vm.parseJsonString(json, string.concat(c, ".action"))));
        if (action == keccak256("openEpoch")) {
            assertEq(curated.length + draws.length, 0, name);
            gov.openEpoch(token, epoch);
        } else if (action == keccak256("prepareBallot")) {
            assertEq(curated.length, 0, name);
            gov.prepareBallot(token, epoch, draws);
        } else {
            assertEq(action, keccak256("prepareCuratedBallot"), name);
            gov.prepareCuratedBallot(token, epoch, curated, draws);
        }

        uint256 nOptions = _u(c, ".nOptions");
        bytes32[] memory options = new bytes32[](nOptions);
        for (uint256 j; j < nOptions; ++j) {
            options[j] = vm.parseJsonBytes32(json, _at(c, ".options", j));
        }
        (bytes32 commitment, uint8 count) = gov.ballotCommitment(token, epoch);
        assertEq(count, nOptions, name);
        assertEq(commitment, keccak256(abi.encodePacked(options)), name);
        assertEq(gov.ballotSizeFor(token, epoch), _u(c, ".size"), name);
        assertEq(gov.isOpened(token, epoch), nOptions >= 2, name);
    }

    function _curated(string memory c, uint16[] memory buckets, bytes32[][] memory leaves)
        internal
        view
        returns (IEpochGovernor.CuratedDraw[] memory d)
    {
        uint256 n = _u(c, ".nCurated");
        d = new IEpochGovernor.CuratedDraw[](n);
        for (uint256 j; j < n; ++j) {
            string memory k = _at(c, ".curated", j);
            uint256 bucket = _u(k, ".bucket");
            uint256 b;
            while (buckets[b] != bucket) ++b;
            // forge-lint: disable-next-line(unsafe-typecast)
            d[j].catalogIndex = uint32(_u(k, ".catalogIndex"));
            d[j].pickOrgId = vm.parseJsonBytes32(json, string.concat(k, ".pickOrgId"));
            d[j].pickProof = CatalogTree.proof(leaves[b], _u(k, ".rank"));
            int256 entry = vm.parseJsonInt(json, string.concat(k, ".entry"));
            if (entry >= 0) {
                // forge-lint: disable-next-line(unsafe-typecast)
                uint256 e = uint256(entry);
                d[j].entryOrgId = cat.entryAt(e).orgId;
                d[j].entryProof = cat.proofOf(e);
            }
        }
    }

    function _draws(string memory c) internal view returns (IEpochGovernor.Draw[] memory d) {
        uint256 n = _u(c, ".nDraws");
        d = new IEpochGovernor.Draw[](n);
        for (uint256 j; j < n; ++j) {
            uint256 e = vm.parseJsonUint(json, _at(c, ".draws", j));
            d[j] = IEpochGovernor.Draw({orgId: cat.entryAt(e).orgId, proof: cat.proofOf(e)});
        }
    }
}
