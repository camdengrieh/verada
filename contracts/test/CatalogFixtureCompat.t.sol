pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";

import {CauseCatalog} from "../src/CauseCatalog.sol";

/// @notice The JS catalogue builder (`@openzeppelin/merkle-tree` standard tree) and the SDK's
///         pool math produce roots, proofs and rotation indices the contracts accept. The fixture
///         is generated by `packages/cause-catalog` (`gen:fixture`) and checked there for drift.
contract CatalogFixtureCompatTest is Test {
    CauseCatalog internal catalog;
    string internal json;

    function setUp() public {
        json = vm.readFile("test/fixtures/catalog.json");
        catalog = new CauseCatalog(address(this));
        uint256[] memory raw = vm.parseJsonUintArray(json, ".bucketSizes");
        uint32[] memory sizes = new uint32[](raw.length);
        for (uint256 i; i < raw.length; ++i) {
            // forge-lint: disable-next-line(unsafe-typecast)
            sizes[i] = uint32(raw[i]);
        }
        catalog.setVersion(vm.parseJsonBytes32(json, ".root"), sizes, bytes32(0));
        vm.warp(block.timestamp + 1);
    }

    function test_everyJsEntryVerifiesOnChain() public view {
        uint256 n = vm.parseJsonUint(json, ".entryCount");
        assertGt(n, 10);
        for (uint256 i; i < n; ++i) {
            string memory e = string.concat(".entries[", vm.toString(i), "]");
            // forge-lint: disable-next-line(unsafe-typecast)
            uint16 bucket = uint16(vm.parseJsonUint(json, string.concat(e, ".bucket")));
            // forge-lint: disable-next-line(unsafe-typecast)
            uint32 index = uint32(vm.parseJsonUint(json, string.concat(e, ".index")));
            bytes32 orgId = vm.parseJsonBytes32(json, string.concat(e, ".orgId"));
            bytes32[] memory proof = vm.parseJsonBytes32Array(json, string.concat(e, ".proof"));
            assertTrue(catalog.verify(1, bucket, index, orgId, proof), "JS proof rejected");
            assertFalse(catalog.verify(1, bucket, index, keccak256(abi.encode(orgId)), proof));
        }
    }

    function test_poolMathMatchesSdk() public view {
        // forge-lint: disable-next-line(unsafe-typecast)
        uint64 cm = uint64(vm.parseJsonUint(json, ".focus.categoryMask"));
        // forge-lint: disable-next-line(unsafe-typecast)
        uint16 rm = uint16(vm.parseJsonUint(json, ".focus.regionMask"));
        uint256 size = vm.parseJsonUint(json, ".focus.poolSize");
        assertEq(catalog.poolSize(1, cm, rm), size);
        assertEq(
            catalog.poolSize(1, type(uint64).max, type(uint16).max),
            vm.parseJsonUint(json, ".anyPoolSize")
        );

        address token = vm.parseJsonAddress(json, ".rotation.token");
        uint256 epoch = vm.parseJsonUint(json, ".rotation.epoch");
        // forge-lint: disable-next-line(unsafe-typecast)
        uint32 version = uint32(vm.parseJsonUint(json, ".rotation.version"));
        for (uint256 k; k < 5; ++k) {
            string memory d = string.concat(".rotation.draws[", vm.toString(k), "]");
            uint256 poolIndex = uint256(keccak256(abi.encode(token, epoch, version, k))) % size;
            assertEq(poolIndex, vm.parseJsonUint(json, string.concat(d, ".poolIndex")), "drawIndex");
            (uint16 bucket, uint32 index) = catalog.locate(1, cm, rm, poolIndex);
            assertEq(bucket, vm.parseJsonUint(json, string.concat(d, ".bucket")), "bucket");
            assertEq(index, vm.parseJsonUint(json, string.concat(d, ".index")), "index");
        }
    }
}
